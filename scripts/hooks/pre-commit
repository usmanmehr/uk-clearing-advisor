#!/usr/bin/env bash
# Pre-commit guardrail - blocks commits containing secrets or personal data.
# See scripts/check_sensitive_content.py for what's checked.
#
# This file lives in scripts/hooks/ (tracked by git) rather than
# .git/hooks/ (never tracked by git, local to each clone) so it travels
# with the repo. Install once per clone with:
#   git config core.hooksPath scripts/hooks
# (see CONTRIBUTING.md). Not installed automatically - a local hook is a
# local safety net, not a substitute for the CI check in
# .github/workflows/cfn-lint.yml, which runs regardless of whether anyone
# installed this.

set -euo pipefail
REPO_ROOT="$(git rev-parse --show-toplevel)"

python3 "$REPO_ROOT/scripts/check_sensitive_content.py"
exit_code=$?

if [ "$exit_code" -ne 0 ]; then
  echo "" >&2
  echo "Commit blocked by scripts/hooks/pre-commit. Fix the flagged content and retry." >&2
  echo "To bypass in a genuine emergency: git commit --no-verify (not recommended)." >&2
fi

exit "$exit_code"
